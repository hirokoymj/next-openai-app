datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id    Int     @id @default(autoincrement())
  firstName String
  lastName  String
  gender    String
  email String
  city String
}

model Todo {
  id    Int     @id @default(autoincrement())
  title  String
  completed Boolean
}
